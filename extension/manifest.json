{
  "manifest_version": 3,
  "name": "SK Home — New Tab",
  "short_name": "SK Home",
  "version": "1.0.0",
  "description": "Replaces Chrome's New Tab page with your personal start page. Fully local — no permissions, no network.",
  "minimum_chrome_version": "110",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [],
  "host_permissions": []
}
